APP_NAME="GLPI Audit Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Timezone used to display audit timestamps (the middleware stores them in UTC).
APP_TIMEZONE=Asia/Kuching
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# This dashboard is read-only and needs no database.
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- GLPI middleware (Node/Express) the dashboard reads from ---
# This is the MIDDLEWARE host (10.0.0.184), NOT the GLPI server (10.0.0.11).
# Must be reachable from the PHP server AND from the browser (for photos).
MIDDLEWARE_BASE_URL=http://10.0.0.184:3003
MIDDLEWARE_TIMEOUT=15

# --- GLPI REST API (login + asset search) ---
# This is the GLPI server (10.0.0.11). Only GLPI_URL + GLPI_APP_TOKEN are
# required: users log in with their own GLPI account and that session is reused
# for searching. GLPI_LOGIN/GLPI_PASSWORD are an OPTIONAL service-account
# fallback (not needed in normal use).
GLPI_URL=http://10.0.0.11/glpi/apirest.php
GLPI_APP_TOKEN=
GLPI_LOGIN=
GLPI_PASSWORD=
GLPI_TIMEOUT=15

# --- Role-based access control (RBAC) ---
# Comma-separated GLPI usernames that are ALWAYS full Administrators, regardless
# of the database. Set this to your own GLPI username before rollout so you can
# reach the User Access page and can never be locked out.
RBAC_SUPER_ADMINS=
# Role applied to any logged-in user who has no explicit assignment yet.
# Keeps existing users working (read-only audit access). Set empty to deny by default.
RBAC_DEFAULT_ROLE=Viewer

# --- Forms OCR (Tesseract runs in the middleware; see deploy/ocr/README.md) ---
# These are set on the MIDDLEWARE (Node) side, not the dashboard, but noted here
# for reference: OCR_LANG=eng, OCR_LANG_PATH=<middleware>/ocr-lang
